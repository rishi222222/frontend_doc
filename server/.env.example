# Public frontend origin(s), comma-separated. No path, no trailing slash.
# Example: https://frontenddoc-client-wxsi.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Required in production. Cross-origin Vercel + Render needs both:
COOKIE_SECURE=true
COOKIE_SAMESITE=none

PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/mohit_doc_viewer
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
