# Server environment variables
PORT=5001
NODE_ENV=development

# MongoDB Connection String (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/trustvault?retryWrites=true&w=majority

# Frontend URL (comma-separated if multiple, e.g. local + Vercel)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# JWT Secrets (at least 32 characters each)
JWT_ACCESS_SECRET=your-random-32-char-access-secret-key-1234
JWT_REFRESH_SECRET=your-random-32-char-refresh-secret-key-5678

# Cookie & Session configuration
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seed accounts (automatically created on first run if database is empty)
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin123!@#
SEED_EMPLOYEE_EMAIL=employee@company.com
SEED_EMPLOYEE_PASSWORD=Employee123!@#
