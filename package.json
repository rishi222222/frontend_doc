{
  "name": "trustvault",
  "version": "1.0.0",
  "private": true,
  "description": "Secure document management and distribution system",
  "scripts": {
    "start": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:dev": "npm --prefix client run dev",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:seed": "npm --prefix server run seed"
  }
}
